Cell[BoxData["\<\"result(0, 0) += -(xWeight*(1 - y)*(1 - z)); result(0, 1) += \
-((1 - x)*yWeight*(1 - z)); result(0, 2) += -((1 - x)*(1 - \
y)*zWeight);\\nresult(1, 0) += xWeight*(1 - y)*(1 - z); result(1, 1) += \
-(x*yWeight*(1 - z)); result(1, 2) += -(x*(1 - y)*zWeight);\\nresult(2, 0) += \
xWeight*y*(1 - z); result(2, 1) += x*yWeight*(1 - z); result(2, 2) += \
-(x*y*zWeight);\\nresult(3, 0) += -(xWeight*y*(1 - z)); result(3, 1) += (1 - \
x)*yWeight*(1 - z); result(3, 2) += -((1 - x)*y*zWeight);\\nresult(4, 0) += \
-(xWeight*(1 - y)*z); result(4, 1) += -((1 - x)*yWeight*z); result(4, 2) += \
(1 - x)*(1 - y)*zWeight;\\nresult(5, 0) += xWeight*(1 - y)*z; result(5, 1) += \
-(x*yWeight*z); result(5, 2) += x*(1 - y)*zWeight;\\nresult(6, 0) += \
xWeight*y*z; result(6, 1) += x*yWeight*z; result(6, 2) += \
x*y*zWeight;\\nresult(7, 0) += -(xWeight*y*z); result(7, 1) += (1 - \
x)*yWeight*z; result(7, 2) += (1 - x)*y*zWeight;\\n\"\>"], "Output",
 CellChangeTimes->{
  3.607955482218638*^9, 3.607955607637723*^9, {3.607955687133279*^9, 
   3.607955712148562*^9}}]
}, Open  ]],

