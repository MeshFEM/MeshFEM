set terminal pngcairo size 1024,768
set output "minEdgeLengths.png";

set xlabel "Mesh Number";
set ylabel "Length";

set logscale y;

set title "minimum edge"
plot '< sort -g edge_lengths.dat' using 1:2 with lp;

set output "maxEdgeLengths.png";


set title "maximum edge length"
plot '< sort -g edge_lengths.dat' using 1:3 with lp;
